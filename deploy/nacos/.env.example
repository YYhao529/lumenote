# Nacos 服务端配置（复制成 .env 后按需改：cp .env.example .env）
# 版本选择：项目是 Spring Cloud Alibaba 2022.0.0.0 / nacos-client 2.2.x，
# 服务端走 2.x 线（2.2~2.4 客户端协议一致），不要用 3.x。

NACOS_VERSION=v2.4.3
NACOS_HTTP_PORT=8848

# 开发环境关掉鉴权（2.2+ 默认开），控制台免登录；生产必须打开并配 token.secret.key
NACOS_AUTH_ENABLE=false

# 项目 bootstrap.yaml 里写的是 namespace: lumenote，命名空间 ID 必须正好是 lumenote
NACOS_NAMESPACE=lumenote

# 对外公告的 IP：Nacos 2.x 会把它当作服务端地址告诉客户端，客户端据此连 gRPC（8848+1000）。
# 不配的话容器自检成 172.x 内网 IP，宿主机/其它机器上的客户端都会连不上。
NACOS_SERVER_IP=192.168.100.111

# 宿主机目录（日志/数据）
NACOS_LOG_DIR=/opt/lumenote/nacos/logs
NACOS_DATA_DIR=/opt/lumenote/nacos/data

# 数据库：密码留空会自动沿用 ../mysql8/.env 里的 MYSQL_ROOT_PASSWORD，
# 想让 Nacos 用独立账号时再把 MYSQL_USER / MYSQL_PASSWORD 一起填上。
MYSQL_HOST=host.docker.internal   # 容器内回连宿主机上的 mysql8
MYSQL_PORT=3306
MYSQL_USER=root
# MYSQL_PASSWORD=
NACOS_DB=nacos_config
