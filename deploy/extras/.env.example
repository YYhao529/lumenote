# 剩余依赖：MinIO / Elasticsearch / Cassandra / Canal / xxl-job
# 复制成 .env：cp .env.example .env
# MySQL 的密码会自动从 ../mysql8/.env 继承，不用在这里重复填

# ---------- MinIO（oss 模块）----------
# 镜像：官方 minio/minio 已从 Docker Hub 撤下，这里默认用已拉到本机的镜像名，
# 需要换源时改这一行即可（compose 里引用 MINIO_IMAGE）
MINIO_IMAGE=minio/minio:latest
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 项目里 storage.minio.accessKey 默认 deepsea；MinIO 要求 secret 至少 8 位
MINIO_ROOT_USER=deepsea
MINIO_ROOT_PASSWORD=12345678
# 代码里写死的桶名：FileServiceImpl.BUCKET_NAME（MinIO 不会自动建桶，需手工创建）
MINIO_BUCKET=deepsea-lumenote
MINIO_DATA_DIR=/opt/lumenote/minio/data

# ---------- Elasticsearch（search 模块，客户端是 rest-high-level-client 7.3.0）----------
# 镜像与客户端同版本最稳；官方 docker.elastic.co 拉不动时用 Docker Hub 的 elasticsearch:7.3.0
ES_IMAGE=elasticsearch:7.3.0
ES_VERSION=7.3.0
ES_PORT=9200
ES_DATA_DIR=/opt/lumenote/es/data

# ---------- Cassandra（kv 模块）----------
CASSANDRA_VERSION=4.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=lumenote
CASSANDRA_DATA_DIR=/opt/lumenote/cassandra/data

# ---------- Canal（不在本栈里跑：canal 部署在宿主机 Windows 上）----------
# 这里只负责在 MySQL 里建好它要用的复制账号；宿主机 canal 的 instance.properties 用这组账号。
CANAL_DB_USER=canal
CANAL_DB_PASSWORD=canal
# 可选：以后若改回容器部署，构建见 canal-build/Dockerfile，模板见 conf/canal/
# CANAL_CONF_DIR=/opt/lumenote/canal/conf
# CANAL_LOG_DIR=/opt/lumenote/canal/logs

# ---------- xxl-job（data-align 模块）----------
XXL_JOB_VERSION=2.4.1
XXL_JOB_PORT=7777
XXL_JOB_ACCESS_TOKEN=default_token
XXL_JOB_DB=xxl_job

# ---------- ZooKeeper（Leaf 雪花模式分配 workerId）----------
# 镜像用 Docker Hub 官方 library/zookeeper（本机已拉到 3.5.6）
ZK_IMAGE=zookeeper:3.5.6
ZK_PORT=2181
ZK_DATA_DIR=/opt/lumenote/zookeeper/data
ZK_DATALOG_DIR=/opt/lumenote/zookeeper/datalog
