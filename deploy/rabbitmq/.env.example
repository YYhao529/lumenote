# RabbitMQ 配置（复制成 .env：cp .env.example .env）
RABBITMQ_VERSION=3.13-management-alpine
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# 管理后台的管理员账号（镜像启动时创建，vhost 为 /）
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123

# 项目用的业务账号和 vhost（start-rabbitmq.sh 会幂等创建）
# 对应 note 模块配置：username: ${RABBITMQ_USERNAME:deepsea} / virtual-host: /lumenote
RABBITMQ_APP_USER=deepsea
RABBITMQ_APP_PASS=1234
RABBITMQ_VHOST=/lumenote

# 数据目录（宿主机，绑定挂载进容器 /var/lib/rabbitmq）
RABBITMQ_DATA_DIR=/opt/lumenote/rabbitmq/data
