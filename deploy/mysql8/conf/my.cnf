[mysqld]
# ---- 字符集：项目连接串用 characterEncoding=utf-8，服务端统一 utf8mb4 ----
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# ---- 时区：与项目 serverTimezone=Asia/Shanghai 对齐 ----
default-time-zone = '+08:00'

# ---- 认证插件：见 docker-compose.yml 里的说明（项目 useSSL=false 必需） ----
default-authentication-plugin = mysql_native_password

# ---- 连接与内存（按 2C4G 虚拟机保守取值，可自行放大） ----
max_connections        = 300
max_connect_errors     = 2000
innodb_buffer_pool_size = 256M
table_open_cache       = 2000
tmp_table_size         = 64M
max_heap_table_size    = 64M
max_allowed_packet     = 64M

# ---- 慢查询与日志 ----
slow_query_log      = ON
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time     = 2
log_error_verbosity = 2

# ---- 关闭 X Protocol（33060），省一个端口 ----
mysqlx = 0

# ---- 二进制日志（Canal 订阅变更依赖）----
# MySQL 8.0 默认就开 binlog，但这里显式写死，避免换镜像/改参数后被默认值带走。
# Canal 的硬性要求：ROW 格式 + FULL 行镜像 + 全局唯一 server_id
log-bin                         = binlog
server-id                       = 1
binlog_format                   = ROW
binlog_row_image                = FULL
sync_binlog                     = 1
max_binlog_size                 = 512M
binlog_expire_logs_seconds      = 604800   # 保留 7 天，够回溯又不至于撑爆磁盘

# 容器里用 IP 连接，关掉反向域名解析可以少一类连接超时问题
skip-name-resolve = 1

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
