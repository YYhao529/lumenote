# ============================================================
# 复制成 .env 后按需修改：cp .env.example .env
# 密码里不要有空格、# 和引号
# ============================================================

# root 密码（必填）
MYSQL_ROOT_PASSWORD=lumenote@123456
# 允许 root 从宿主机/其他机器连接（开发虚拟机才建议 %，生产用具体网段）
MYSQL_ROOT_HOST=%

# 业务账号（deploy 脚本会在容器启动后创建）
MYSQL_APP_USER=lumenote
MYSQL_APP_PASSWORD=lumenote@123456

# 宿主机映射端口（被占用时可改成 3307）
MYSQL_PORT=3306

# 业务库名
MYSQL_DATABASE=lumenote

# 数据目录：宿主机路径，绑定挂载到容器内 /var/lib/mysql
# 想放到独立数据盘就改成挂载点下的路径，例如 /data/mysql8
MYSQL_DATA_DIR=/opt/lumenote/mysql8/data
